<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.0.4 Chrome/138.0.7204.97 Electron/37.2.1 Safari/537.36" compressed="false" version="28.0.4">
  <diagram id="dark-detailed" name="MVP Detailed Design">
    <mxGraphModel dx="921" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" background="#0B1220" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Real-time Decision Engine MVP — Low-latency HTTP Adapter Design" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="45" y="25" width="1100" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Design target: peak 300 TPS | End-to-end P95 &amp;lt; 200 ms | One L2-3 EC2 for the initial MVP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#CBD5E1;" parent="1" vertex="1">
          <mxGeometry x="45" y="70" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="replay" value="&lt;b&gt;Splunk Log Replay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;De-identified 3DS requests&lt;br&gt;Open-loop, original timestamps&lt;br&gt;1x / 1.5x / 2x / burst&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#60A5FA;strokeWidth=2;fontColor=#F8FAFC;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="360" width="200" height="145" as="geometry" />
