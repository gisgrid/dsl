        <mxCell id="e6" value="push; no polling" style="edgeStyle=none;html=1;rounded=0;strokeColor=#22D3EE;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="grpcclient" target="sourcegateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
