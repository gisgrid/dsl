          <mxGeometry x="700" y="125" width="880" height="790" as="geometry" />
        </mxCell>
        <mxCell id="l23title" value="L2-3 decision-engine — Single EC2 for MVP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="718" y="135" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="adapterjvm" value="" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#1E3A5F;swimlaneFillColor=#101D2E;strokeColor=#38BDF8;strokeWidth=2;fontColor=#F8FAFC;fontStyle=1;align=left;spacingLeft=10;arcSize=5;" parent="1" vertex="1">
          <mxGeometry x="735" y="205" width="280" height="615" as="geometry" />
        </mxCell>
        <mxCell id="adaptertitle" value="HTTP Adapter JVM — one process" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="750" y="212" width="235" height="25" as="geometry" />
        </mxCell>
        <mxCell id="endpoint" value="&lt;b&gt;POST /decision&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Non-blocking HTTP server&lt;br&gt;Validate requestId / deadline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#7DD3FC;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="750" y="275" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="inflight" value="&lt;b&gt;In-flight Request Map&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Every accepted request briefly enters&lt;br&gt;requestId → CompletableFuture&lt;br&gt;Removed on result / timeout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B1F5C;strokeColor=#C084FC;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="750" y="410" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="buffer" value="&lt;b&gt;Small Bounded Buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;In-memory only; not a service&lt;br&gt;Short handoff + overload guard&lt;br&gt;Reject fast when full&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12352B;strokeColor=#4ADE80;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="750" y="565" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="grpcclient" value="&lt;b&gt;Persistent gRPC Stream Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Push requests; receive results&lt;br&gt;Same-EC2 loopback for MVP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12352B;strokeColor=#4ADE80;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="750" y="720" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="flinkcluster" value="" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#12352B;swimlaneFillColor=#0E211D;strokeColor=#4ADE80;strokeWidth=2;fontColor=#F8FAFC;fontStyle=1;align=left;spacingLeft=10;arcSize=5;" parent="1" vertex="1">
          <mxGeometry x="1050" y="205" width="490" height="650" as="geometry" />
        </mxCell>
        <mxCell id="flinktitle" value="Flink Standalone Cluster — same EC2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1065" y="212" width="320" height="25" as="geometry" />
        </mxCell>
        <mxCell id="jm" value="&lt;b&gt;JobManager JVM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Deploys and coordinates the job&lt;br&gt;Checkpoint / restart coordination&lt;br&gt;Not in per-request data path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#A1A1AA;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1090" y="270" width="405" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tm" value="" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#14532D;swimlaneFillColor=#102A1B;strokeColor=#4ADE80;strokeWidth=2;fontColor=#F8FAFC;fontStyle=1;align=left;spacingLeft=10;arcSize=5;" parent="1" vertex="1">
          <mxGeometry x="1080" y="405" width="430" height="400" as="geometry" />
        </mxCell>
        <mxCell id="tmtitle" value="TaskManager JVM — executes one Flink Job" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1095" y="411" width="330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sourcegateway" value="&lt;b&gt;Custom Source Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Persistent gRPC server&lt;br&gt;push into SourceReader&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164E63;strokeColor=#22D3EE;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1110" y="465" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="keyrules" value="&lt;b&gt;Keyed Rules + State&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;keyBy(cardId)&lt;br&gt;rule evaluation&lt;br&gt;reason codes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;strokeColor=#4ADE80;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1325" y="465" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="asyncmodel" value="&lt;b&gt;Async I/O: SageMaker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;bounded concurrency&lt;br&gt;timeout + fallback&lt;br&gt;no operator-thread blocking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A2C0A;strokeColor=#FB923C;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1110" y="610" width="155" height="90" as="geometry" />
        </mxCell>
        <mxCell id="aggregate" value="&lt;b&gt;Decision Aggregation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;score + rules&lt;br&gt;decision / reason codes&lt;br&gt;deterministic fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532D;strokeColor=#4ADE80;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1320" y="610" width="155" height="90" as="geometry" />
        </mxCell>
        <mxCell id="slots" value="&lt;b&gt;Parallelism N inside the one Job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;N parallel subtasks distributed across Task Slots&lt;br&gt;Example MVP: 4 slots / parallelism 4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#94A3B8;dashed=1;fontColor=#E2E8F0;" parent="1" vertex="1">
          <mxGeometry x="1110" y="740" width="365" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sagemaker" value="" style="swimlane;html=1;rounded=1;startSize=40;fillColor=#3B1F5C;swimlaneFillColor=#21122F;strokeColor=#C084FC;strokeWidth=2;fontColor=#F8FAFC;fontStyle=1;align=left;spacingLeft=10;arcSize=6;" parent="1" vertex="1">
          <mxGeometry x="1640" y="385" width="220" height="250" as="geometry" />
        </mxCell>
        <mxCell id="smtitle" value="L2-5 SageMaker AI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1655" y="393" width="185" height="25" as="geometry" />
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;XGBoost Endpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;20+ features&lt;br&gt;Warm instance(s)&lt;br&gt;Persistent connections&lt;br&gt;Measure P95 separately&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#321B46;strokeColor=#C084FC;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1670" y="465" width="160" height="115" as="geometry" />
        </mxCell>
        <mxCell id="capture" value="&lt;b&gt;Non-blocking Data Capture / Metrics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;E2E and stage P50/P95/P99; TPS; timeouts; in-flight; buffer depth; model latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272A;strokeColor=#A1A1AA;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="1050" y="955" width="490" height="80" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Latency-focused MVP decisions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1. Adapter, map and buffer are one JVM — not three services.&lt;br&gt;2. No polling: adapter pushes over one persistent same-host gRPC stream.&lt;br&gt;3. JobManager is control plane and is not traversed by each request.&lt;br&gt;4. Every accepted request enters the in-flight map for correlation; normal completion removes it immediately.&lt;br&gt;5. Buffer is deliberately small and bounded: overload is rejected instead of silently increasing latency.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#64748B;strokeWidth=2;fontColor=#E2E8F0;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="735" width="580" height="250" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="HTTPS request" style="edgeStyle=none;html=1;rounded=0;strokeColor=#60A5FA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;" parent="1" source="replay" target="riskapi" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="validated request" style="edgeStyle=none;html=1;rounded=0;strokeColor=#7DD3FC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;" parent="1" source="riskapi" target="httpclient" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="internal HTTPS / requestId + deadline" style="edgeStyle=none;html=1;rounded=0;strokeColor=#60A5FA;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;" parent="1" source="httpclient" target="endpoint" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="short handoff" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4ADE80;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="inflight" target="buffer" edge="1">
          <mxGeometry relative="1" as="geometry" />
