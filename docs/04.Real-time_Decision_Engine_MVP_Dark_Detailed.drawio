          <mxGeometry x="290" y="250" width="330" height="360" as="geometry" />
        </mxCell>
        <mxCell id="l21title" value="L2-1 risk-score — Java API / EC2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="305" y="258" width="295" height="26" as="geometry" />
        </mxCell>
        <mxCell id="riskapi" value="&lt;b&gt;Risk Scoring API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ACS contract + AREQ mapping&lt;br&gt;Validation / idempotency&lt;br&gt;Start E2E timer&lt;br&gt;Set overall deadline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A5F;strokeColor=#7DD3FC;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="335" y="320" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="httpclient" value="&lt;b&gt;Async HTTP Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Connection pool + keep-alive&lt;br&gt;Propagate requestId + deadline&lt;br&gt;Receive DecisionResponse&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A5F;strokeColor=#7DD3FC;strokeWidth=2;fontColor=#F8FAFC;" parent="1" vertex="1">
          <mxGeometry x="335" y="480" width="240" height="95" as="geometry" />
