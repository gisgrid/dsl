        <mxCell id="e7" value="drain immediately" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4ADE80;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="buffer" target="grpcclient" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="stream record" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4ADE80;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;" parent="1" source="sourcegateway" target="keyrules" edge="1">
          <mxGeometry y="-25" relative="1" as="geometry">
