        <mxCell id="e9" value="model features" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4ADE80;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;" parent="1" source="keyrules" target="asyncmodel" edge="1">
