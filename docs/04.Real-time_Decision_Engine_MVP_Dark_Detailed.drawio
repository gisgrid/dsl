        <mxCell id="e11" value="score" style="edgeStyle=none;html=1;rounded=0;strokeColor=#C084FC;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#F8FAFC;labelBackgroundColor=#0B1220;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="model" target="aggregate" edge="1">
